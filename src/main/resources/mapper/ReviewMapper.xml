<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wenhua.venue.mapper.ReviewMapper">

    <resultMap id="BaseResultMap" type="Review">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="venue_id" property="venueId"/>
        <result column="reservation_id" property="reservationId"/>
        <result column="rating" property="rating"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
        <result column="username" property="username"/>
        <result column="venue_name" property="venueName"/>
    </resultMap>

    <sql id="baseSelect">
        SELECT rv.*, u.username, v.name AS venue_name
        FROM review rv
        LEFT JOIN user u ON rv.user_id = u.id
        LEFT JOIN venue v ON rv.venue_id = v.id
    </sql>

    <select id="selectByVenueId" resultMap="BaseResultMap">
        <include refid="baseSelect"/>
        WHERE rv.venue_id = #{venueId} ORDER BY rv.id DESC
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        <include refid="baseSelect"/>
        ORDER BY rv.id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        <include refid="baseSelect"/>
        WHERE rv.id = #{id}
    </select>

    <insert id="insert" parameterType="Review" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO review (user_id, venue_id, reservation_id, rating, content)
        VALUES (#{userId}, #{venueId}, #{reservationId}, #{rating}, #{content})
    </insert>

    <delete id="deleteById">
        DELETE FROM review WHERE id = #{id}
    </delete>
</mapper>
