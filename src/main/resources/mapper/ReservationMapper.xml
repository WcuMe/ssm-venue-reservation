<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wenhua.venue.mapper.ReservationMapper">

    <resultMap id="BaseResultMap" type="Reservation">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="venue_id" property="venueId"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="total_price" property="totalPrice"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="username" property="username"/>
        <result column="venue_name" property="venueName"/>
    </resultMap>

    <sql id="baseSelect">
        SELECT r.*, u.username, v.name AS venue_name
        FROM reservation r
        LEFT JOIN user u ON r.user_id = u.id
        LEFT JOIN venue v ON r.venue_id = v.id
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        <include refid="baseSelect"/>
        WHERE r.id = #{id}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        <include refid="baseSelect"/>
        WHERE r.user_id = #{userId} ORDER BY r.id DESC
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        <include refid="baseSelect"/>
        ORDER BY r.id DESC
    </select>

    <!-- 时间段冲突：与 [startTime, endTime) 存在交集且未取消 -->
    <select id="selectConflicts" resultMap="BaseResultMap">
        <include refid="baseSelect"/>
        WHERE r.venue_id = #{venueId}
          AND r.status IN ('PENDING', 'CONFIRMED')
          AND r.start_time &lt; #{endTime}
          AND r.end_time &gt; #{startTime}
    </select>

    <insert id="insert" parameterType="Reservation" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO reservation (order_no, user_id, venue_id, start_time, end_time, total_price, status, remark)
        VALUES (#{orderNo}, #{userId}, #{venueId}, #{startTime}, #{endTime}, #{totalPrice}, #{status}, #{remark})
    </insert>

    <update id="updateStatus">
        UPDATE reservation SET status = #{status} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM reservation WHERE id = #{id}
    </delete>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM reservation
    </select>
</mapper>
